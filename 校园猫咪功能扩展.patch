+.card-header {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  margin-bottom: 16rpx;
+}
+
+.cat-name {
+  font-size: 34rpx;
+  font-weight: bold;
+  color: #576b95;
+}
+
+.apply-time {
+  font-size: 22rpx;
+  color: #999;
+}
+
+.info-row {
+  font-size: 26rpx;
+  color: #333;
+  margin-top: 10rpx;
+}
+
+.info-label {
+  color: #999;
+}
+
+.contact {
+  color: #576b95;
+}
+
+.reason {
+  font-size: 26rpx;
+  color: #333;
+  background: #f7f7f7;
+  border-radius: 12rpx;
+  padding: 16rpx;
+  margin-top: 16rpx;
+  line-height: 1.6;
+}
+
+.review-info {
+  margin-top: 16rpx;
+  border-top: 1rpx solid #f0f0f0;
+  padding-top: 16rpx;
+}
+
+.actions {
+  display: flex;
+  justify-content: flex-end;
+  /* gap兼容处理：用margin代替 */
+  margin-top: 20rpx;
+}
+
+.btn-approve {
+  background: #07c160;
+  color: #fff;
+}
+
+.btn-reject {
+  background: #fff;
+  color: #f5222d;
+  border: 1rpx solid #f5222d;
+}
+
+.modal-mask {
+  position: fixed;
+  top: 0;
+  left: 0;
+  right: 0;
+  bottom: 0;
+  background: rgba(0, 0, 0, 0.5);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  z-index: 100;
+}
+
+.modal {
+  width: 600rpx;
+  background: #fff;
+  border-radius: 16rpx;
+  padding: 32rpx;
+}
+
+.modal-title {
+  font-size: 32rpx;
+  font-weight: bold;
+  text-align: center;
+}
+
+.modal-desc {
+  font-size: 26rpx;
+  color: #666;
+  text-align: center;
+  margin-top: 12rpx;
+}
+
+.modal-textarea {
+  background: #f7f7f7;
+  border-radius: 12rpx;
+  padding: 20rpx;
+  width: 100%;
+  height: 180rpx;
+  box-sizing: border-box;
+  font-size: 26rpx;
+  margin-top: 24rpx;
+}
+
+.modal-buttons {
+  display: flex;
+  /* gap兼容处理：用margin代替 */
+  margin-top: 24rpx;
+}
+
+.modal-btn {
+  flex: 1;
+  font-size: 28rpx;
+}
+
+.modal-btn.cancel {
+  background: #f5f5f5;
+  color: #666;
+}
+
+.modal-btn.confirm {
+  background: #07c160;
+  color: #fff;
+}
+
+.actions button, .modal-buttons button { margin-left: 20rpx; }
+.actions button:first-child, .modal-buttons button:first-child { margin-left: 0; }
