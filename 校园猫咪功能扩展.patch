+        <view class="mini-btn snack" bindtap="toFeedRecord" data-cat_id="{{cat._id}}" data-category="snack">零食</view>
+      </view>
+    </view>
+  </view>
+
+  <view style="height: 40rpx;"></view>
+</view>
