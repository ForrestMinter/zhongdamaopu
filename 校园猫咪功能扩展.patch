diff --git a/miniprogram/pages/feed/feedRecord/feedRecord.wxml b/miniprogram/pages/feed/feedRecord/feedRecord.wxml
new file mode 100644
index 0000000..663d822
--- /dev/null
+++ b/miniprogram/pages/feed/feedRecord/feedRecord.wxml
@@ -0,0 +1,98 @@
+<!-- 喂食/零食打卡与记录 -->
+<view class="page">
+  <!-- 统计区 -->
+  <view class="stats-card">
+    <view class="stat-item">
+      <view class="stat-num">{{stats.meal_total}}</view>
+      <view class="stat-label">喂食总打卡</view>
+    </view>
+    <view class="stat-item">
+      <view class="stat-num snack">{{stats.snack_total}}</view>
+      <view class="stat-label">零食总打卡</view>
+    </view>
+    <view class="stat-item">
+      <view class="stat-num">{{stats.last7d}}</view>
+      <view class="stat-label">近7天</view>
+    </view>
+    <view class="stat-item">
+      <view class="stat-num">{{stats.last30d}}</view>
+      <view class="stat-label">近30天</view>
+    </view>
+  </view>
+
+  <view class="last-feed" wx:if="{{stats.last_feed}}">
+    最近一次{{stats.last_feed.feed_category === 'snack' ? '零食' : '喂食'}}：{{stats.last_feed.created_at_formatted}}<text wx:if="{{stats.last_feed.user_name}}">（{{stats.last_feed.user_name}}）</text>
+  </view>
+  <view class="last-feed" wx:elif="{{!loading}}">还没有记录，来打第一卡吧</view>
+
+  <button class="checkin-btn {{category === 'snack' ? 'snack-btn' : ''}} {{todayChecked ? 'checked' : ''}}" bindtap="openCheckin">
+    {{todayChecked ? '今日已打卡 ✓' : categoryDesc[category] + '打卡'}}
+  </button>
+
+  <!-- 记录列表 -->
+  <view class="block-title">{{categoryDesc[category]}}记录</view>
+  <view class="empty" wx:if="{{!loading && records.length === 0}}">暂无记录</view>
+
+  <view class="record-card" wx:for="{{records}}" wx:key="_id">
+    <view class="record-header">
+      <view class="user-name">
+        {{item.user_name || '热心同学'}}
+        <text class="snack-tag" wx:if="{{item.feed_category === 'snack'}}">{{item.snack_type}}</text>
+      </view>
+      <view class="feed-date">{{item.feed_date}} {{item.feed_time}}</view>
+    </view>
+    <view class="record-info" wx:if="{{item.location}}">地点：{{item.location}}</view>
+    <view class="record-info" wx:if="{{item.note}}">{{item.note}}</view>
+    <view class="record-footer">
+      <view class="created-at">{{item.created_at_formatted}} 打卡</view>
+      <view class="delete-btn" wx:if="{{item.isMine}}" bindtap="removeRecord" data-id="{{item._id}}">删除</view>
+    </view>
+  </view>
+
+  <!-- 打卡弹窗 -->
+  <view class="modal-mask" wx:if="{{showCheckinModal}}" bindtap="closeCheckin">
+    <view class="modal" catchtap="">
+      <view class="modal-title">{{categoryDesc[category]}}打卡</view>
+
+      <view class="form-item" wx:if="{{category === 'snack'}}">
+        <view class="label">零食类型</view>
+        <picker range="{{snackTypes}}" value="{{form.snackTypeIndex}}" bindchange="onSnackTypeChange">
+          <view class="picker">{{snackTypes[form.snackTypeIndex] || '请选择'}} ▾</view>
+        </picker>
+      </view>
+
+      <view class="form-item">
+        <view class="label">{{categoryDesc[category]}}日期</view>
+        <picker mode="date" value="{{form.feed_date}}" bindchange="onDateChange">
+          <view class="picker">{{form.feed_date}} ▾</view>
+        </picker>
+      </view>
+
+      <view class="form-item">
+        <view class="label">{{categoryDesc[category]}}时间</view>
+        <picker mode="time" value="{{form.feed_time}}" bindchange="onTimeChange">
+          <view class="picker">{{form.feed_time}} ▾</view>
+        </picker>
+      </view>
+
+      <view class="form-item">
