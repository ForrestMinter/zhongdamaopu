@@ -0,0 +1,63 @@
+<!-- 医疗记录管理 -->
+<view class="page">
+  <view class="add-bar">
+    <button class="add-btn" bindtap="addRecord">+ 添加医疗记录</button>
+  </view>
+
+  <view class="empty" wx:if="{{!loading && records.length === 0}}">暂无医疗记录</view>
+
+  <view class="record-card" wx:for="{{records}}" wx:key="_id">
+    <view class="record-header">
+      <view class="type-tag type-{{item.type}}">{{typeNameMap[item.type]}}</view>
+      <view class="record-date">{{item.record_date_formatted}}</view>
+    </view>
+    <view class="record-title">{{item.title}}</view>
+    <view class="record-info" wx:if="{{item.hospital}}">医院/地点：{{item.hospital}}</view>
+    <view class="record-info" wx:if="{{item.description}}">{{item.description}}</view>
+    <view class="record-actions">
+      <button size="mini" bindtap="editRecord" data-index="{{index}}">编辑</button>
+      <button size="mini" class="btn-delete" bindtap="removeRecord" data-id="{{item._id}}" data-index="{{index}}">删除</button>
+    </view>
+  </view>
+
+  <!-- 编辑弹窗 -->
+  <view class="modal-mask" wx:if="{{showEditModal}}" bindtap="closeEdit">
+    <view class="modal" catchtap="">
+      <view class="modal-title">{{editingId ? '编辑记录' : '添加记录'}}</view>
+
+      <view class="form-item">
+        <view class="label">类型</view>
+        <picker range="{{typeOptions}}" range-key="name" value="{{form.typeIndex}}" bindchange="onTypeChange">
+          <view class="picker">{{typeOptions[form.typeIndex].name}} ▾</view>
+        </picker>
+      </view>
+
+      <view class="form-item" wx:if="{{typeOptions[form.typeIndex].key !== 'sterilize'}}">
+        <view class="label">标题</view>
+        <input class="input" placeholder="如：猫瘟治疗、眼部发炎" value="{{form.title}}" data-field="title" bindinput="onInput" />
+      </view>
+
+      <view class="form-item">
+        <view class="label">日期</view>
+        <picker mode="date" value="{{form.record_date}}" bindchange="onDateChange">
+          <view class="picker">{{form.record_date || '请选择日期'}} ▾</view>
+        </picker>
+      </view>
+
+      <view class="form-item">
+        <view class="label">医院/地点（可选）</view>
+        <input class="input" placeholder="就诊医院或处理地点" value="{{form.hospital}}" data-field="hospital" bindinput="onInput" />
+      </view>
+
+      <view class="form-item">
+        <view class="label">备注（可选）</view>
+        <textarea class="textarea" placeholder="病情、用药、恢复情况等" value="{{form.description}}" data-field="description" bindinput="onInput" maxlength="300" />
+      </view>
+
+      <view class="modal-buttons">
+        <button class="modal-btn cancel" bindtap="closeEdit">取消</button>
+        <button class="modal-btn confirm" bindtap="saveRecord" disabled="{{submitting}}">保存</button>
+      </view>
+    </view>
+  </view>
+</view>
