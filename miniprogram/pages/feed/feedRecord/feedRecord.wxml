<!-- 喂食打卡与记录 -->
<view class="page">
  <!-- 统计区 -->
  <view class="stats-card">
    <view class="stat-item">
      <view class="stat-num">{{stats.total}}</view>
      <view class="stat-label">总打卡</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">{{stats.last7d}}</view>
      <view class="stat-label">近7天</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">{{stats.last30d}}</view>
      <view class="stat-label">近30天</view>
    </view>
  </view>

  <view class="last-feed" wx:if="{{stats.last_feed}}">
    最近一次打卡：{{stats.last_feed.created_at_formatted}}<text wx:if="{{stats.last_feed.user_name}}">（{{stats.last_feed.user_name}}）</text>
  </view>
  <view class="last-feed" wx:elif="{{!loading}}">还没有记录，来打第一卡吧</view>

  <button class="checkin-btn {{todayChecked ? 'checked' : ''}}" bindtap="openCheckin">
    {{todayChecked ? '今日已打卡 ✓' : '打卡'}}
  </button>

  <!-- 打卡表单（内嵌面板，不用 fixed 弹窗，避免部分模拟器无法输入） -->
  <view class="checkin-panel" wx:if="{{showCheckinModal}}">
    <view class="modal-title">打卡</view>

    <view class="form-item">
      <view class="label">喂了什么</view>
      <picker range="{{snackTypes}}" value="{{form.snackTypeIndex}}" bindchange="onSnackTypeChange">
        <view class="picker">{{snackTypes[form.snackTypeIndex] || '请选择'}} ▾</view>
      </picker>
    </view>

    <view class="form-item">
      <view class="label">打卡日期</view>
      <picker mode="date" value="{{form.feed_date}}" bindchange="onDateChange">
        <view class="picker">{{form.feed_date}} ▾</view>
      </picker>
    </view>

    <view class="form-item">
      <view class="label">打卡时间</view>
      <picker mode="time" value="{{form.feed_time}}" bindchange="onTimeChange">
        <view class="picker">{{form.feed_time}} ▾</view>
      </picker>
    </view>

    <view class="form-item">
      <view class="label">地点</view>
      <picker wx:if="{{locations.length}}" range="{{locationOptions}}" value="{{form.locationIndex}}" bindchange="onLocationChange">
        <view class="picker">{{form.locationIndex >= 0 ? locationOptions[form.locationIndex] : '请选择地点'}} ▾</view>
      </picker>
      <view class="tip-text" wx:if="{{!locations.length}}">管理员还没有设置打卡地点，请手动输入</view>
      <input wx:if="{{!locations.length || showCustomLocation}}" class="input" placeholder="如：图书馆后草坪" value="{{form.custom_location}}" data-field="custom_location" bindinput="onInput" />
    </view>

    <view class="form-item">
      <view class="label">备注（可选）</view>
      <textarea class="textarea" placeholder="猫猫状态如何、吃了多少等" value="{{form.note}}" data-field="note" bindinput="onInput" maxlength="200" show-confirm-bar="{{false}}"></textarea>
    </view>

    <view class="modal-buttons">
      <button class="modal-btn cancel" bindtap="closeCheckin">取消</button>
      <button class="modal-btn confirm" bindtap="submitCheckin" disabled="{{submitting}}">确认打卡</button>
    </view>
  </view>

  <!-- 记录列表 -->
  <view class="block-title">打卡记录</view>
  <view class="empty" wx:if="{{!loading && records.length === 0}}">暂无记录</view>

  <view class="record-card" wx:for="{{records}}" wx:key="_id">
    <view class="record-header">
      <view class="user-name">
        {{item.user_name || '热心同学'}}
        <text class="snack-tag" wx:if="{{item.food_type || item.snack_type}}">{{item.food_type || item.snack_type}}</text>
      </view>
      <view class="feed-date">{{item.feed_date}} {{item.feed_time}}</view>
    </view>
    <view class="record-info" wx:if="{{item.location}}">地点：{{item.location}}</view>
    <view class="record-info" wx:if="{{item.note}}">{{item.note}}</view>
    <view class="record-footer">
      <view class="created-at">{{item.created_at_formatted}} 打卡</view>
      <view class="delete-btn" wx:if="{{item.isMine}}" bindtap="removeRecord" data-id="{{item._id}}">删除</view>
    </view>
  </view>

</view>
