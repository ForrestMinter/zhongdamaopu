.page {
  padding: 30rpx;
  min-height: 100vh;
  background: #f7f7f7;
  box-sizing: border-box;
}

.stats-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 0;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: bold;
  color: #fa8c16;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.last-feed {
  font-size: 24rpx;
  color: #666;
  text-align: center;
  margin: 24rpx 0;
}

.checkin-btn {
  background: #fa8c16;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
}

.checkin-btn.checked {
  background: #f5f5f5;
  color: #999;
}

.block-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin: 32rpx 8rpx 20rpx;
}

.empty {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 60rpx 0;
}

.record-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.feed-date {
  font-size: 24rpx;
  color: #fa8c16;
}

.record-info {
  font-size: 26rpx;
  color: #666;
  margin-top: 10rpx;
  line-height: 1.5;
}

.record-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
  padding-top: 16rpx;
}

.created-at {
  font-size: 22rpx;
  color: #ccc;
}

.delete-btn {
  font-size: 24rpx;
  color: #f5222d;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal {
  width: 640rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 20rpx;
}

.form-item {
  margin-bottom: 20rpx;
}

.label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.input {
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
}

.textarea {
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  width: 100%;
  height: 140rpx;
  box-sizing: border-box;
}

.picker {
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  color: #333;
}

.modal-buttons {
  display: flex;
  /* gap兼容处理：用margin代替 */
  margin-top: 28rpx;
}

.modal-btn {
  flex: 1;
  font-size: 28rpx;
}

.modal-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.modal-btn.confirm {
  background: #fa8c16;
  color: #fff;
}

.modal-buttons button { margin-left: 20rpx; }
.modal-buttons button:first-child { margin-left: 0; }

/* 打卡食物类型标签 */
.stat-num.snack {
  color: #eb2f96;
}

.snack-btn {
  background: #eb2f96;
}

.snack-tag {
  font-size: 20rpx;
  color: #eb2f96;
  background: #fff0f6;
  border-radius: 16rpx;
  padding: 2rpx 14rpx;
  margin-left: 12rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

/* 打卡内嵌面板（不用 fixed 弹窗，避免部分模拟器无法输入） */
.checkin-panel {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}
