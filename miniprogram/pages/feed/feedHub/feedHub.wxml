<!-- 分地区喂食打卡主页 -->
<view class="page">
  <view class="summary-bar">今日全校区已打卡 {{todayTotal}} 次</view>

  <!-- 校区标签 -->
  <scroll-view class="campus-tabs" scroll-x="1" enhanced="1" show-scrollbar="{{false}}">
    <view class="campus-tab {{activeCampus === item ? 'active' : ''}}" wx:for="{{campusList}}" wx:key="*this" data-campus="{{item}}" bindtap="switchCampus">{{item}}</view>
  </scroll-view>

  <view class="empty" wx:if="{{!loading && areaGroups.length === 0}}">该校区暂无猫咪</view>

  <!-- 区域分组 -->
  <view class="area-section" wx:for="{{areaGroups}}" wx:key="area" wx:for-item="group">
    <view class="area-header">
      <view class="area-name">{{group.area}}</view>
      <view class="area-today {{group.area_today === 0 ? 'none' : ''}}">
        {{group.area_today === 0 ? '今日还没人打卡' : '今日已打卡 ' + group.area_today + ' 次'}}
      </view>
    </view>

    <view class="cat-row" wx:for="{{group.cats}}" wx:key="_id" wx:for-item="cat">
      <image class="cat-avatar" src="{{cat.avatarUrl}}" mode="aspectFill" bindtap="toCatDetail" data-cat_id="{{cat._id}}" />
      <view class="cat-info" bindtap="toCatDetail" data-cat_id="{{cat._id}}">
        <view class="cat-name">{{cat.name}}</view>
        <view class="cat-today {{cat.today_total === 0 ? 'none' : ''}}">
          {{cat.today_total === 0 ? '今日未打卡' : '今日已打卡 ' + cat.today_total + ' 次'}}
        </view>
      </view>
      <view class="checkin-btns">
        <view class="mini-btn meal" bindtap="toFeedRecord" data-cat_id="{{cat._id}}">打卡</view>
      </view>
    </view>
  </view>

  <view style="height: 40rpx;"></view>
</view>
